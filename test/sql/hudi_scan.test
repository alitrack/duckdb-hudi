# name: test/sql/hudi_scan.test
# description: hudi_scan and its read_hudi alias read the same rows through the same parameters
# group: [hudi]

require hudi

statement ok
SET threads=4;

# Both names are registered with the same signature.
query II
SELECT function_name, parameters FROM duckdb_functions()
WHERE function_name IN ('hudi_scan', 'read_hudi') ORDER BY function_name;
----
hudi_scan	[col0, as_of, start, end, hudi_option]
read_hudi	[col0, as_of, start, end, hudi_option]

# Snapshot, time travel and incremental reads.
query II
SELECT count(*), sum("intField") FROM hudi_scan('test/fixture/cow_v6_nonpartitioned');
----
4	120000

query II
SELECT count(*), sum("intField") FROM hudi_scan('test/fixture/cow_v6_nonpartitioned', as_of => '20240418173550988');
----
3	75000

query II
SELECT count(*), sum("intField") FROM hudi_scan('test/fixture/cow_v6_nonpartitioned', start => '20240418173550988', "end" => '20240418173551906');
----
2	60000

# Every column and row matches the alias, on copy-on-write and merge-on-read.
query I
SELECT count(*) FROM (
    (SELECT * FROM hudi_scan('test/fixture/cow_v6_simplekeygen_nonhivestyle') EXCEPT ALL
     SELECT * FROM read_hudi('test/fixture/cow_v6_simplekeygen_nonhivestyle'))
    UNION ALL
    (SELECT * FROM read_hudi('test/fixture/cow_v6_simplekeygen_nonhivestyle') EXCEPT ALL
     SELECT * FROM hudi_scan('test/fixture/cow_v6_simplekeygen_nonhivestyle')));
----
0

query I
SELECT count(*) FROM (
    (SELECT * FROM hudi_scan('test/fixture/mor_v6_simplekeygen_nonhivestyle') EXCEPT ALL
     SELECT * FROM read_hudi('test/fixture/mor_v6_simplekeygen_nonhivestyle'))
    UNION ALL
    (SELECT * FROM read_hudi('test/fixture/mor_v6_simplekeygen_nonhivestyle') EXCEPT ALL
     SELECT * FROM hudi_scan('test/fixture/mor_v6_simplekeygen_nonhivestyle')));
----
0

# Each name keeps filter pushdown and shows up under its own name in the plan.
query II
EXPLAIN (FORMAT json) SELECT count(*) FROM hudi_scan('test/fixture/cow_v6_simplekeygen_nonhivestyle') WHERE "byteField" = 10;
----
physical_plan	<REGEX>:(?s).*"FILTER".*"HUDI_SCAN".*"Hudi Filters": "byteField = 10".*"Partitions": "1 / 3".*"File Slices": "1 / 3".*

query II
EXPLAIN (FORMAT json) SELECT count(*) FROM read_hudi('test/fixture/cow_v6_simplekeygen_nonhivestyle') WHERE "byteField" = 10;
----
physical_plan	<REGEX>:(?s).*"FILTER".*"READ_HUDI".*"Hudi Filters": "byteField = 10".*"Partitions": "1 / 3".*"File Slices": "1 / 3".*

# Errors.
statement error
SELECT * FROM hudi_scan('test/fixture/cow_v6_nonpartitioned', as_of => 'x', start => 'y');
----
hudi_scan: `as_of` (time-travel snapshot) and `start`/`end` (incremental) are mutually exclusive

statement error
SELECT * FROM hudi_scan(NULL::VARCHAR);
----
hudi_scan: the table path (uri) is required

statement error
SELECT * FROM hudi_scan('/nonexistent/no/such/table');
----
hudi_scan: failed to open

# The alias is covered by read_hudi.test, and reports errors under the same name.
statement error
SELECT * FROM read_hudi(NULL::VARCHAR);
----
hudi_scan: the table path (uri) is required
